# Operating mode of the execution service.
#   rpc       - serve current-state JSON-RPC (default). Blocks are not
#               validated; the beacon node follows the chain optimistically.
#   validator / full - EXPERIMENTAL: validate every block for validator
#               duties. Disabled unless PULSELITE_EXPERIMENTAL_VALIDATOR=true
#               (and set LIGHTHOUSE_EXTRA_FLAGS= empty so lighthouse syncs
#               deposit logs). Blocks are not yet validated within the slot.
PULSELITE_MODE=rpc
PULSELITE_EXPERIMENTAL_VALIDATOR=false
LIGHTHOUSE_EXTRA_FLAGS=--disable-deposit-contract-sync

# Consensus client + optional services (comma separated compose profiles):
#   lighthouse | prysm, plus optionally proxy
# Note: prysm-pulse v2.3.0 currently cannot import new blocks from PulseChain
# peers (it reads the 4-byte fork digest of p2p responses with a single
# short read and rejects them as "digest=0x845ee500"), so lighthouse is the default.
COMPOSE_PROFILES=lighthouse
LIGHTHOUSE_PULSE_VERSION=v2.5.1
PRYSM_PULSE_VERSION=v2.3.0

# State, headers, bodies and receipts come from the PulseChain devp2p network
# (snap + eth protocols, ordinary go-pulse peers); no RPC provider is used.
P2P_PORT=30303
P2P_MAXPEERS=50
# OPT-IN ONLY: RPC endpoints to use instead of the p2p network (leave empty).
PULSELITE_UPSTREAM=

# Disk budget. Empty = defaults for the mode:
#   rpc:            cache 1GiB, execution dir limit 3GiB, total hard limit 8GB
#   validator/full: cache 4GiB, execution dir limit 10GiB, total hard limit 25GB
CACHE_MAX_BYTES=
EXEC_DISK_LIMIT=
TOTAL_DISK_LIMIT=
# Consensus database (lighthouse). rpc mode: fresh checkpoint sync on every
# start, and again whenever its database outgrows the budget (MB).
# Validator modes: LH_FRESH_START=false, LH_DB_BUDGET_MB=0 (set by setup).
LH_FRESH_START=true
LH_DB_BUDGET_MB=2000
LOGS_WINDOW=1024
BLOCKS_WINDOW=128
SLOTS_PER_ARCHIVE_POINT=8192

# RPC + dashboard: http://127.0.0.1:${RPC_PORT}
# RPC_BIND=127.0.0.1 keeps it on this computer; 0.0.0.0 exposes it to your
# LAN (phones, other PCs). Never forward it to the internet unprotected.
RPC_BIND=127.0.0.1
RPC_PORT=8545
METRICS_PORT=6060
BEACON_API_PORT=3500
PROXY_PORT=8080

# Validator profiles only (experimental)
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Docker named volume (fast on Docker Desktop) or a host path such as ./data.
DATA_DIR=pulselite-data
LOG_LEVEL=info
